+  // One line per 2 s window, for benchmarking without the HUD (DXMT_STATS_FILE).
+  void LogStatistics(
+      const FrameStatisticsContainer &statistics, clock::time_point boundary_t0, uint32_t latency, UINT sync_interval
+  ) {
+    auto now = clock::now();
+    stats_boundary_ += now - boundary_t0;
+    if (stats_last_present_ != clock::time_point{})
+      stats_intervals_.push_back(std::chrono::duration<float, std::milli>(now - stats_last_present_).count());
+    else
+      stats_start_ = stats_window_ = now;
+    stats_last_present_ = now;
+    if (now - stats_window_ < std::chrono::seconds(2) || stats_intervals_.empty())
+      return;
+
+    auto &v = stats_intervals_;
+    std::sort(v.begin(), v.end());
+    auto pct = [&](double p) { return v[std::min(v.size() - 1, (size_t)(p * v.size()))]; };
+    double window_s = std::chrono::duration<double>(now - stats_window_).count();
+    auto ms = [](clock::duration d) { return d.count() / 1000000.0; };
+    auto &avg = statistics.average();
+    fprintf(stats_file_, "%.1f %zu %.2f %.2f %.2f %.2f %.2f %.2f %.2f %.2f %.2f %.2f %.2f %u %u\n",
+            std::chrono::duration<double>(now - stats_start_).count(), v.size(), v.size() / window_s,
+            pct(0.5), pct(0.95), pct(0.99), v.back(), ms(stats_boundary_) / v.size(),
+            ms(avg.encode_prepare_interval), ms(avg.encode_flush_interval), ms(avg.drawable_blocking_interval),
+            ms(avg.commit_interval), ms(avg.sync_interval), latency, sync_interval);
+    fflush(stats_file_);
+    v.clear();
+    stats_boundary_ = {};
+    stats_window_ = now;
+  }
